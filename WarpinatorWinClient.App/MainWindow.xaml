<Window x:Class="WarpinatorWinClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:WarpinatorWinClient.App.Models"
        mc:Ignorable="d"
        Title="Warpinator Windows Client"
        Width="1260"
        Height="820"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#FF071118">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF0D1822" />
            <GradientStop Offset="1" Color="#FF0A121A" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#CC111D29" />
            <GradientStop Offset="1" Color="#CC0D1620" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FF47E0D1" />
            <GradientStop Offset="1" Color="#FF66A6FF" />
        </LinearGradientBrush>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#889FB4C5" />
        </Style>
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#1236D4E8" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TransferProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Foreground" Value="#FF47E0D1" />
            <Setter Property="Background" Value="#1831D0E6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Width="6" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="6" MinWidth="0" MinHeight="28">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbChrome" Background="#3C8CA7B5" CornerRadius="3" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbChrome" Property="Background" Value="#708CA7B5" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbChrome" Property="Background" Value="#FF47E0D1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Margin="0,24,8,24"
                                       Style="{StaticResource WorkspaceScrollBarStyle}" Orientation="Vertical"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF041017" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#1EF4FBFF" />
            <Setter Property="Foreground" Value="#FFDFFAFF" />
        </Style>
        <Style x:Key="ShelfIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="#1636D4E8" />
            <Setter Property="BorderBrush" Value="#2D7DEAFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Reveal in Explorer" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2147E0F0" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF47E0D1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A2DBFCF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#1535D9F3" />
            <Setter Property="Margin" Value="0,18,0,18" />
        </Style>
        <Style x:Key="DropStageStyle" TargetType="Border">
            <Setter Property="Background" Value="#12192A36" />
            <Setter Property="BorderBrush" Value="#1F76E9FF" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="24" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDropTargetActive}" Value="True">
                    <Setter Property="Background" Value="#1833F6EE" />
                    <Setter Property="BorderBrush" Value="#FF47E0D1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Ellipse Width="460" Height="460" Margin="-100,-120,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#3027D4FF" />
        <Ellipse Width="420" Height="420" Margin="0,120,-120,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="#202CF0D8" />
        <Ellipse Width="520" Height="520" Margin="0,0,140,-220" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#143A74FF" />

        <Border Margin="16"
                CornerRadius="34"
                Background="#E6080F14"
                BorderBrush="#1F77E7FF"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="34,0,0,34"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="#1833D3E7"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="34,34,30,34">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#AA7DEAFF" Text="LOCAL TRANSFER LINK" />
                            <TextBlock Margin="0,16,0,0" FontFamily="Segoe UI Variable Display" FontSize="44" FontWeight="SemiBold" Foreground="#FFF4FCFF" Text="Warpinator" />
                            <TextBlock FontFamily="Segoe UI Variable Display" FontSize="24" Foreground="#A7BDE3F2" Text="futuristic file relay" />
                            <TextBlock Margin="0,18,0,0" FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="#C3D6E2EC" Text="{Binding CompatibilitySummary}" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Peers" />
                                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" Foreground="#FFF6FDFF" Text="{Binding PeerCountSummary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Finished" />
                                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" Foreground="#FFF6FDFF" Text="{Binding TransferCountSummary}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="2" Margin="0,30,0,20" Style="{StaticResource WorkspaceScrollViewerStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="SearchPeersButton" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Style="{StaticResource QuietButtonStyle}" Padding="12,8"
                                            Click="SearchPeersClicked" Content="{Binding SearchButtonText}"
                                            IsEnabled="{Binding CanSearch}" ToolTip="Search for nearby Warpinator devices" />
                                    <TextBlock Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Text="Devices" />
                                </DockPanel>
                                <TextBlock Margin="0,12,0,0" FontSize="14" TextWrapping="Wrap" Foreground="#FFE6FBFF" Text="{Binding TransferReadiness}" />
                                <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#99B6C6D1" Text="{Binding StatusMessage}" />
                                <Border Style="{StaticResource DividerStyle}" />
                                <ItemsControl ItemsSource="{Binding Peers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:PeerSummary}">
                                            <Border Margin="0,0,0,14" Padding="16,15" Background="#111A2A35" CornerRadius="20">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" Padding="10,5" Background="#1539E4F5" CornerRadius="12">
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FFB7FEFF" Text="{Binding Availability}" />
                                                        </Border>
                                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"
                                                                   Foreground="#FFF4FCFF" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DisplayName}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#99B6C6D1" Text="{Binding Endpoint}" />
                                                    <TextBlock Margin="0,8,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="#AAC8D6E0" Text="{Binding Details}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Receive folder" />
                            <TextBlock Margin="0,10,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="#C6D9E4EC" Text="{Binding SaveFolderSummary}" />
                            <Button x:Name="SettingsButton" Margin="0,18,0,0" HorizontalAlignment="Left" Padding="12,8"
                                    Style="{StaticResource QuietButtonStyle}" Content="Settings" Click="SettingsClicked" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="WorkspaceScrollViewer" Grid.Column="1" Style="{StaticResource WorkspaceScrollViewerStyle}">
                    <Grid Margin="34,30,34,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="36" FontWeight="SemiBold" Foreground="#FFF4FCFF" Text="Transfer deck" />
                                <TextBlock Margin="0,8,0,0" FontSize="14" TextWrapping="Wrap" Foreground="#9DB8C7D2" Text="Send files and follow their progress." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,16,0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FFBFFDFF" Text="{Binding ConnectionSummary}" />
                                </Border>
                                <Button Style="{StaticResource ActionButtonStyle}" Click="SendFileClicked" Content="Send File" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.02*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="1.28*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource DropStageStyle}"
                                    AllowDrop="True"
                                    DragEnter="SendStageDragEnter"
                                    DragOver="SendStageDragOver"
                                    DragLeave="SendStageDragLeave"
                                    Drop="SendStageDrop">
                                <Grid Margin="26">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Outbound lane" />
                                        <TextBlock Margin="0,12,0,0" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Foreground="#FFF4FCFF" TextWrapping="Wrap" Text="Drop files to send" />
                                        <TextBlock Margin="0,10,0,0" FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="#A9C3D1DC" Text="Drag files from Explorer or choose them below to send to your connected device." />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,24,0,24" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FF7FF9EE" Text="Drag and drop is active" />
                                        <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" Foreground="#8FB7C9D7" Text="Multiple files are sent one after another." />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <Button Style="{StaticResource ActionButtonStyle}" Click="SendFileClicked" Content="Choose Files" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Padding="26" Background="{StaticResource SurfaceBrush}" BorderBrush="#1E6FD8F5" BorderThickness="1" CornerRadius="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LiveTransferLabel" Style="{StaticResource LabelStyle}"
                                                   Margin="0,0,20,0" VerticalAlignment="Center" Text="Live transfer" />
                                        <Border x:Name="LiveTransferStatusBadge" Grid.Column="1" Style="{StaticResource StatusBadgeStyle}">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FFBDFEFF" Text="{Binding ActiveTransferStatus}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="26" LineHeight="32" MaxHeight="64"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveTransferName}"
                                                   FontWeight="SemiBold" Foreground="#FFF7FDFF" Text="{Binding ActiveTransferName}" />
                                        <TextBlock Margin="0,10,0,0" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ActiveTransferPeer}" Foreground="#9CC3D3DF" Text="{Binding ActiveTransferPeer, StringFormat=Peer: {0}}" />
                                        <TextBlock Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#FF7AF9EE" Text="{Binding ActiveTransferDirection}" />
                                        <TextBlock Margin="0,12,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="#C1D7E3EB" Text="{Binding ActiveTransferSummary}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Margin="0,24,0,0">
                                        <ProgressBar Style="{StaticResource TransferProgressStyle}" Minimum="0" Maximum="100" Value="{Binding ActiveTransferProgressPercent, Mode=OneWay}" />
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LiveTransferProgressText" Margin="0,0,20,0" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveTransferProgressSummary}"
                                                       Foreground="#C1D7E3EB" Text="{Binding ActiveTransferProgressSummary}" />
                                            <TextBlock x:Name="LiveTransferProgressPercent" Grid.Column="1" MinWidth="32" TextAlignment="Right"
                                                       FontSize="12" FontWeight="SemiBold" Foreground="#FF7AF9EE"
                                                       Visibility="{Binding HasActiveTransfer, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Text="{Binding ActiveTransferProgressPercent, StringFormat={}{0:0}%}" />
                                        </Grid>
                                    </StackPanel>

                                    <Grid Grid.Row="3" Margin="0,24,0,0" Visibility="{Binding HasActiveTransfer, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelStyle}" Text="Speed" />
                                            <TextBlock Margin="0,8,20,0" FontSize="14" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ActiveTransferSpeedSummary}" FontWeight="SemiBold" Foreground="#FFF4FCFF" Text="{Binding ActiveTransferSpeedSummary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource LabelStyle}" Text="ETA" />
                                            <TextBlock Margin="0,8,0,0" FontSize="14" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ActiveTransferEtaSummary}" FontWeight="SemiBold" Foreground="#FFF4FCFF" Text="{Binding ActiveTransferEtaSummary}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,28,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Recent activity" />
                                <TextBlock Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" Foreground="#93B4C5D4" Text="Open received files in Explorer with the folder button." />
                                <Border Style="{StaticResource DividerStyle}" />
                            </StackPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentTransfers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TransferSummary}">
                                        <Border Margin="0,0,0,12" Padding="18,18" Background="#0C15212C" CornerRadius="16">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock x:Name="HistoryTransferName" FontSize="16" FontWeight="SemiBold" Foreground="#FFF7FDFF"
                                                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <TextBlock FontSize="12" Foreground="#96B8CAD7" Text="{Binding Peer}" />
                                                            <TextBlock Margin="10,0" FontSize="12" Foreground="#536E8292" Text="/" />
                                                            <TextBlock FontSize="12" Foreground="#FF7AF9EE" Text="{Binding Direction}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <StackPanel x:Name="HistoryTransferActions" Grid.Column="1" Margin="24,0,0,0"
                                                                Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Style="{StaticResource ShelfIconButtonStyle}"
                                                                Margin="0,0,12,0" VerticalAlignment="Center"
                                                                Click="RevealTransferClicked"
                                                                Tag="{Binding RevealPath}"
                                                                Visibility="{Binding CanReveal, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                AutomationProperties.Name="Reveal in Explorer">
                                                            <Viewbox Width="16" Height="16">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Stroke="#FFF4FCFF"
                                                                          StrokeThickness="1.7"
                                                                          StrokeLineJoin="Round"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round"
                                                                          Data="M2.5,8.5 L9,8.5 L11.2,10.8 L21.5,10.8 L21.5,19.5 C21.5,20.33 20.83,21 20,21 L4,21 C3.17,21 2.5,20.33 2.5,19.5 Z M2.5,8.5 L2.5,5.5 C2.5,4.67 3.17,4 4,4 L8.2,4 C8.66,4 9.09,4.21 9.38,4.58 L10.8,6.5 L16,6.5" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                        <Border Style="{StaticResource StatusBadgeStyle}">
                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FFBDFEFF" Text="{Binding Status}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Margin="0,12,0,0" FontSize="12" LineHeight="18" MaxHeight="36" TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" Foreground="#A8C1D2DF" Text="{Binding Summary}" />
                                                <ProgressBar Style="{StaticResource TransferProgressStyle}" Margin="0,16,0,0"
                                                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}"
                                                             Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,16,0" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               Foreground="#91B5C7D5" Text="{Binding ProgressSummary}" />
                                                    <TextBlock Grid.Column="1" Margin="0,0,16,0" FontSize="12" Foreground="#91B5C7D5" Text="{Binding SpeedSummary}"
                                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBlock Grid.Column="2" FontSize="12" Foreground="#91B5C7D5" Text="{Binding EtaSummary}"
                                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
