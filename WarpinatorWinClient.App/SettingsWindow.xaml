<Window x:Class="WarpinatorWinClient.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#FF0A141C">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#FFF4FCFF" Text="Settings" />
            <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#99B6C6D1" Text="Receiving files" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0">
                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#FFF4FCFF" Text="Show receive approval" />
                <TextBlock Margin="0,8,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="#A8C1D2DF"
                           Text="Ask before accepting files from another device." />
            </StackPanel>
            <CheckBox x:Name="ReceiveApprovalCheckBox" Grid.Column="1" VerticalAlignment="Center"
                      IsChecked="True" Cursor="Hand" AutomationProperties.Name="Show receive approval">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ToggleLabel" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   FontSize="13" Foreground="#99B6C6D1" Text="No" />
                                        <Border x:Name="ToggleTrack" Width="44" Height="26" CornerRadius="13" Background="#FF344650">
                                            <Ellipse x:Name="ToggleThumb" Width="18" Height="18" Margin="4"
                                                     Fill="#FFF4FCFF" HorizontalAlignment="Left" />
                                        </Border>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ToggleLabel" Property="Text" Value="Yes" />
                                            <Setter TargetName="ToggleLabel" Property="Foreground" Value="#FF7AF9EE" />
                                            <Setter TargetName="ToggleTrack" Property="Background" Value="#FF147F78" />
                                            <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.8" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#FF47E0D1" />
                                            <Setter TargetName="ToggleTrack" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
        </Grid>
        <TextBlock Grid.Row="2" Margin="0,20,0,0" FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="#829CACBC"
                   Text="Applies to new transfer requests. When set to No, incoming files are received automatically." />
        <StackPanel Grid.Row="3" Margin="0,28,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,12,0" Style="{StaticResource QuietButtonStyle}" Content="Cancel" IsCancel="True" />
            <Button x:Name="SaveSettingsButton" Style="{StaticResource ActionButtonStyle}" Content="Save" Click="SaveClicked" />
        </StackPanel>
    </Grid>
</Window>
